{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .specialities-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr); /* Mobile: 1 per row for visibility, or 2 if small */
    gap: 1.5rem;
  }

  @media screen and (min-width: 480px) {
     .specialities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .specialities-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .speciality-card {
    display: flex;
    align-items: center;
    background: {{ section.settings.card_background }};
    padding: 1.5rem; /* Compact padding */
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 4px; /* Slight radius or 0 for sharp look */
  }

  .speciality-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-right: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .speciality-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .speciality-icon svg {
    width: 100%;
    height: 100%;
    fill: {{ section.settings.icon_color }};
    stroke: {{ section.settings.icon_color }};
  }

  .speciality-text {
    color: {{ section.settings.text_color }};
    font-size: 1.4rem;
    line-height: 1.3;
    font-weight: 500;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="specialities-grid">
      {%- for block in section.blocks -%}
        <div class="speciality-card" {{ block.shopify_attributes }}>
          <div class="speciality-icon">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy' }}
            {%- elsif block.settings.svg_code != blank -%}
              {{ block.settings.svg_code }}
            {%- else -%}
              {% render 'icon-accordion' %}
            {%- endif -%}
          </div>
          <div class="speciality-text">
            {{ block.settings.text | escape }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Specialities",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Default Icon Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (Optional)"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "SVG Icon Code (Optional)",
          "info": "Paste SVG code here if not using an image."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "10 Year Warranty"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specialities",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "10 Year Warranty"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Direct Selling: Factory to Customer"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "66 Quality Checks"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Kiln Dried and Heat Treated"
          }
        }
      ]
    }
  ]
}
{% endschema %}
